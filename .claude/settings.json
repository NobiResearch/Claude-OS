{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bin/cos)",
      "Bash(bin/cos *)",
      "Bash(./bin/cos *)",
      "Bash(cos *)",
      "Bash(python3 -m unittest *)",
      "Bash(git status*)",
      "Bash(sw_vers*)",
      "Bash(pmset -g*)",
      "Bash(mdfind *)",
      "Bash(shortcuts list*)"
    ],
    "ask": [
      "Bash(bin/cos clean apply*)",
      "Bash(./bin/cos clean apply*)",
      "Bash(cos clean apply*)",
      "Bash(bin/cos update apply*)",
      "Bash(./bin/cos update apply*)",
      "Bash(cos update apply*)",
      "Bash(bin/cos daemon install*)",
      "Bash(./bin/cos daemon install*)",
      "Bash(cos daemon install*)",
      "Bash(bin/cos daemon uninstall*)",
      "Bash(./bin/cos daemon uninstall*)",
      "Bash(cos daemon uninstall*)",
      "Bash(bin/cos daemon run*)",
      "Bash(./bin/cos daemon run*)",
      "Bash(cos daemon run*)",
      "Bash(bin/cos evolve merge*)",
      "Bash(./bin/cos evolve merge*)",
      "Bash(cos evolve merge*)",
      "Bash(bin/cos evolve discard*)",
      "Bash(./bin/cos evolve discard*)",
      "Bash(cos evolve discard*)",
      "Bash(bin/cos install*)",
      "Bash(./bin/cos install*)",
      "Bash(cos install*)",
      "Bash(bin/cos uninstall*)",
      "Bash(./bin/cos uninstall*)",
      "Bash(cos uninstall*)",
      "Bash(bin/cos cal connect*)",
      "Bash(./bin/cos cal connect*)",
      "Bash(cos cal connect*)",
      "Bash(bin/cos weather set*)",
      "Bash(./bin/cos weather set*)",
      "Bash(cos weather set*)",
      "Bash(bin/cos weather clear*)",
      "Bash(./bin/cos weather clear*)",
      "Bash(cos weather clear*)",
      "Bash(bin/cos feeds add*)",
      "Bash(./bin/cos feeds add*)",
      "Bash(cos feeds add*)",
      "Bash(bin/cos feeds mute*)",
      "Bash(./bin/cos feeds mute*)",
      "Bash(cos feeds mute*)",
      "Bash(bin/cos config*)",
      "Bash(./bin/cos config*)",
      "Bash(cos config*)",
      "Bash(bin/cos startup --full*)",
      "Bash(./bin/cos startup --full*)",
      "Bash(cos startup --full*)",
      "Bash(git push*)",
      "Bash(git -C * push*)",
      "Bash(git -c * push*)",
      "Bash(gh pr merge*)",
      "Bash(gh-axi pr merge*)",
      "Bash(gh api*)",
      "Bash(gh-axi api*)",
      "Bash(gh alias set*)",
      "Bash(gh extension install*)",
      "Bash(gh stack*)",
      "Bash(gh-axi stack*)"
    ],
    "deny": [
      "Edit(~/.claude-os/config.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/bin/cos boot",
            "timeout": 15
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/bin/cos hook permission || true",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/bin/cos statusline",
    "padding": 0
  }
}
