{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bin/cos)",
      "Bash(bin/cos *)",
      "Bash(./bin/cos *)",
      "Bash(cos *)",
      "Bash(sw_vers*)",
      "Bash(pmset -g*)",
      "Bash(mdfind *)",
      "Bash(shortcuts list*)"
    ],
    "ask": [
      "Bash(bin/cos clean apply*)",
      "Bash(./bin/cos clean apply*)",
      "Bash(cos clean apply*)",
      "Bash(bin/cos update apply*)",
      "Bash(./bin/cos update apply*)",
      "Bash(cos update apply*)",
      "Bash(bin/cos daemon install*)",
      "Bash(./bin/cos daemon install*)",
      "Bash(cos daemon install*)",
      "Bash(bin/cos daemon uninstall*)",
      "Bash(./bin/cos daemon uninstall*)",
      "Bash(cos daemon uninstall*)",
      "Bash(bin/cos daemon run*)",
      "Bash(./bin/cos daemon run*)",
      "Bash(cos daemon run*)",
      "Bash(bin/cos install*)",
      "Bash(./bin/cos install*)",
      "Bash(cos install*)",
      "Bash(bin/cos uninstall*)",
      "Bash(./bin/cos uninstall*)",
      "Bash(cos uninstall*)",
      "Bash(bin/cos cal connect*)",
      "Bash(./bin/cos cal connect*)",
      "Bash(cos cal connect*)",
      "Bash(bin/cos weather set*)",
      "Bash(./bin/cos weather set*)",
      "Bash(cos weather set*)",
      "Bash(bin/cos weather clear*)",
      "Bash(./bin/cos weather clear*)",
      "Bash(cos weather clear*)",
      "Bash(bin/cos feeds add*)",
      "Bash(./bin/cos feeds add*)",
      "Bash(cos feeds add*)",
      "Bash(bin/cos feeds mute*)",
      "Bash(./bin/cos feeds mute*)",
      "Bash(cos feeds mute*)",
      "Bash(bin/cos config*)",
      "Bash(./bin/cos config*)",
      "Bash(cos config*)",
      "Bash(bin/cos startup --full*)",
      "Bash(./bin/cos startup --full*)",
      "Bash(cos startup --full*)",
      "Bash(bin/cos net --speed*)",
      "Bash(./bin/cos net --speed*)",
      "Bash(cos net --speed*)",
      "Bash(bin/cos security on*)",
      "Bash(./bin/cos security on*)",
      "Bash(cos security on*)",
      "Bash(bin/cos app)",
      "Bash(./bin/cos app)",
      "Bash(cos app)",
      "Bash(bin/cos app install*)",
      "Bash(./bin/cos app install*)",
      "Bash(cos app install*)",
      "Bash(bin/cos app open*)",
      "Bash(./bin/cos app open*)",
      "Bash(cos app open*)",
      "Bash(gh repo delete*)",
      "Bash(gh-axi repo delete*)",
      "Bash(gh release*)",
      "Bash(gh-axi release*)",
      "Bash(gh api *releases*)",
      "Bash(gh-axi api *releases*)",
      "Bash(xcrun notarytool*)",
      "Bash(app/build.sh --release*)",
      "Bash(./app/build.sh --release*)",
      "Bash(*app/build.sh --release*)"
    ],
    "deny": [
      "Edit(~/.claude-os/config.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/bin/cos boot",
            "timeout": 15
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/bin/cos hook permission || true",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/bin/cos statusline",
    "padding": 0
  }
}
